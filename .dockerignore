# Keep the build context small and keep secrets out of the image.
.git
.github
.claude
docs
**/node_modules
**/dist
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
backend/tests
# Rendered config and local env files carry credentials — the platform
# injects everything the pod needs as environment variables.
config.yaml
backend/config.yaml
**/.env
**/.env.*
*.log
.backend_pid
